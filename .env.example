# Copy to .env and change values to override defaults from settings.py

# Server
HOST=0.0.0.0
PORT=5000
DEV_MODE=False

# Logger
LOG_FOLDER=logs
LOG_FILE=logs.log
LOG_LEVEL=20

# Upload limits and decoding
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=60000000
DECODE_LONG_SIDE=1280

# Models
CORNER_MODEL_PATH=models/doccornernet_lean.ort
TEXT_MODEL_PATH=models/ppocrv4_det.onnx
FALLBACK_MODEL_PATH=models/docaligner_lcnet100.onnx
ONNX_THREADS=0

# Document presence
DOC_MIN_CORNER_SCORE=0.5
DOC_MIN_FALLBACK_SCORE=0.5
FALLBACK_HEATMAP_THRESHOLD=0.3
DOC_MIN_TEXT_BOXES=1
DOC_TEXT_LONG_SIDE=960
TEXT_PIXEL_THRESHOLD=0.3
TEXT_BOX_THRESHOLD=0.5
SCREENSHOT_BLOCK_STD=0.6
SCREENSHOT_MIN_FLAT_SHARE=0.5
SCREENSHOT_MIN_MEAN=50
SCREENSHOT_MAX_MEAN=235

# Whole document in frame
FRAME_EDGE_MARGIN=0.03
FRAME_MIN_FALLBACK_SCORE=0.8

# Document size and angle
GEOM_MIN_AREA_SHARE=0.2
GEOM_MAX_SIDE_RATIO=1.5
GEOM_MAX_ANGLE_DEV=30.0

# Image quality
QUALITY_WORK_SIZE=1024
QUALITY_DOC_INSET=0.04
SHARP_WORK_SIZE=384
SHARP_PRE_SMOOTH=0.8
SHARP_MIN_SCORE=20.0
LIGHT_DARK_PIXEL=15
LIGHT_BRIGHT_PIXEL=250
LIGHT_MIN_MEAN=60
LIGHT_MAX_MEAN=240
LIGHT_MAX_DARK_SHARE=0.3
LIGHT_MAX_BRIGHT_SHARE=0.7
GLARE_MIN_VALUE=245
GLARE_MAX_SATURATION=30
GLARE_PAPER_PERCENTILE=30
GLARE_MIN_ABOVE_PAPER=30
GLARE_MIN_BLOB_SHARE=0.002
LIGHT_MAX_GLARE_SHARE=0.09
